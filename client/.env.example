# Copy to .env.local and fill in from your Microsoft Entra app registration.
# Register a "Single-page application" platform with redirect URI http://localhost:5173/login
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
# Optional: defaults to <current origin>/login
VITE_ENTRA_REDIRECT_URI=
# SyncAI Express API base URL (defaults to /api)
VITE_API_BASE_URL=
