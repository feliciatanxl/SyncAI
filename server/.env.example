# Copy to server/.env (git-ignored). Never put these in client/.env: VITE_ values are public.

# Railway Postgres. Use DATABASE_PUBLIC_URL when running on your laptop, DATABASE_URL when hosted on Railway.
DATABASE_URL=

# Same Application (client) ID as VITE_ENTRA_CLIENT_ID in client/.env
ENTRA_CLIENT_ID=

# Creates the FIRST admin only: while the users table has no admin, the first sign-in whose email is listed here
# becomes an approved admin. Once any admin exists this does nothing; an admin assigns every other role.
ADMIN_EMAILS=

# Optional: comma-separated tenant IDs allowed to sign in. Empty = any Microsoft account (still pending until approved)
ALLOWED_TENANT_IDS=

# Days to keep activity (audit) records before they're deleted automatically. Default 365 (12 months)
ACTIVITY_RETENTION_DAYS=365

PORT=3000
